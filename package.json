{
  "name": "logseq-plugin-deepseek-assistant",
  "version": "1.2.1",
  "main": "dist/index.html",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "eslint src test live --ext .ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:live": "vitest run --config live/vitest.config.ts",
    "preinstall": "npx only-allow pnpm",
    "docs:prompts": "WRITE_DOCS=1 vitest run test/prompt-reference.test.ts"
  },
  "license": "MIT",
  "dependencies": {
    "@logseq/libs": "^0.3.4"
  },
  "devDependencies": {
    "@semantic-release/changelog": "6.0.2",
    "@semantic-release/exec": "6.0.3",
    "@semantic-release/git": "10.0.1",
    "@semantic-release/npm": "9.0.2",
    "@types/node": "18.15.3",
    "@typescript-eslint/eslint-plugin": "5.55.0",
    "@typescript-eslint/parser": "5.55.0",
    "conventional-changelog-conventionalcommits": "5.0.0",
    "eslint": "8.36.0",
    "semantic-release": "20.1.1",
    "typescript": "4.9.5",
    "vite": "4.2.3",
    "vite-plugin-logseq": "1.1.2",
    "vitest": "0.34.6"
  },
  "logseq": {
    "id": "logseq-plugin-deepseek-assistant",
    "title": "DeepSeek Assistant",
    "icon": "./logo.svg"
  },
  "description": "Run DeepSeek models from Logseq slash commands: summarize, polish, rewrite, explain, brainstorm and fact-check a block without leaving your notes.",
  "author": "victos",
  "repo": "victos/logseq-plugin-ds",
  "effect": true
}
